# Copia este archivo como .env (en local) o pon estas variables en Vercel → Settings → Environment Variables.
# Sin ellas la app arranca en MODO DEMO.
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave anon / publishable de Supabase>
VITE_VAPID_PUBLIC_KEY=<clave pública VAPID (npx web-push generate-vapid-keys)>
